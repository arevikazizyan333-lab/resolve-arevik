{
  "_comment_1": "Copy to .claude/settings.json to activate. Hooks load at SESSION START - restart claude after copying.",
  "_comment_2": "matcher is a regex over the TOOL NAME. 'Edit' alone misses Write and MultiEdit.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-audit.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}